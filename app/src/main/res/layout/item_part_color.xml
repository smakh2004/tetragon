<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <!-- Ring hugs the swatch: same rounded-square shape, slightly larger, blue stroke -->
    <View
        android:id="@+id/swatch_ring"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_part_swatch_ring"
        android:visibility="invisible" />

    <View
        android:id="@+id/swatch_color"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_part_swatch_circle" />
</FrameLayout>