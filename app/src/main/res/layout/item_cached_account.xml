<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowWrapperLayout"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/deleteAccountIndicator"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_minus_circle"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/accountAvatarGraphic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/avatar_1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/accountNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/text_color"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Sirojiddin" />

            <TextView
                android:id="@+id/accountEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/gray_1"
                android:textSize="13sp"
                tools:text="bilkhamzhanov@bk.ru" />
        </LinearLayout>

        <ImageView
            android:id="@+id/navigationArrowGraphic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/continue_btn"
            app:tint="#E2E7EA" />

    </LinearLayout>

    <View
        android:id="@+id/cellDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="#F0F3F5" />
</LinearLayout>