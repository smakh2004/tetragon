<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".ui.uiMathStormOnline.OnlineResultBattleMathStormActivity">

    <!-- MAIN CONTENT CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="true">

        <!-- RESULT TITLE (TOP) -->
        <TextView
            android:id="@+id/resultTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0"
            android:textColor="@color/text_color"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="You Won!" />

        <!-- XP GAIN LABEL (DIRECTLY UNDER THE TITLE) -->
        <TextView
            android:id="@+id/xpGainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0"
            android:textColor="@color/blue_2"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/resultTitleText"
            tools:text="+30 XP" />

        <!-- MY SECTION (LEFT HALF) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mySection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/exit_btn_container"
            app:layout_constraintEnd_toStartOf="@+id/opponentSection"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/xpGainLabel">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/myPlayerIconImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleX="1.25"
                android:scaleY="1.25"
                android:translationX="5dp"
                android:translationY="-94dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riveAlignment="CENTER"
                app:riveAutoPlay="true"
                app:riveFit="FIT_WIDTH"
                app:riveResource="@raw/avatar_result_math_storm"
                app:riveStateMachine="State Machine 1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- OPPONENT SECTION (RIGHT HALF) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/opponentSection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/mySection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/mySection"
            app:layout_constraintTop_toTopOf="@+id/mySection">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/opponentPlayerIconImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleX="1.25"
                android:scaleY="1.25"
                android:translationX="-5dp"
                android:translationY="-94dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:riveAlignment="CENTER"
                app:riveAutoPlay="true"
                app:riveFit="FIT_WIDTH"
                app:riveResource="@raw/avatar_result_math_storm"
                app:riveStateMachine="State Machine 1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- EXIT / CONTINUE BUTTON AT BOTTOM -->
        <FrameLayout
            android:id="@+id/exit_btn_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- ENABLED BUTTON -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <!-- shadow -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/black_2"
                    android:translationY="5dp" />

                <!-- button -->
                <Button
                    android:id="@+id/exit_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/custom_button"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0"
                    android:stateListAnimator="@drawable/button_animator"
                    android:text="@string/continue_text"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    app:backgroundTint="@color/black_3" />
            </FrameLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LOADING OVERLAY CONTAINER -->
    <FrameLayout
        android:id="@+id/loadingOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/blue_2" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/loading"
                android:textColor="@color/text_color" />
        </LinearLayout>
    </FrameLayout>

    <!-- XP COUNTER ANIMATION — last child so it draws above the avatars and title -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/xpAnimationView"
        android:layout_width="310dp"
        android:layout_height="320dp"
        android:clickable="false"
        android:visibility="gone"
        android:focusable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riveAlignment="TOP_RIGHT"
        app:riveAutoPlay="true"
        app:riveFit="COVER"
        app:riveResource="@raw/xp_animation"
        app:riveStateMachine="State Machine 1" />
</androidx.constraintlayout.widget.ConstraintLayout>