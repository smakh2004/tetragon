<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".accountPicking.StartOrLoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigationHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backArrowButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/back_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#B5BDC4" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationHeaderBar"
        app:layout_constraintVertical_bias="0.38">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Уже есть аккаунт?"
            android:textColor="#5C6B73"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnSignInContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="5dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/black_2"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btnSignInRoute"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/inter_semibold"
                android:stateListAnimator="@drawable/button_animator"
                android:text="ВОЙТИ"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/black_3" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="36dp"
            android:background="#F0F3F5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Впервые на Тетрагон?"
            android:textColor="#5C6B73"
            android:textSize="18sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnSignUpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="5dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/blue_1"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btnSignUpRoute"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/inter_semibold"
                android:stateListAnimator="@drawable/button_animator"
                android:text="НАЧАТЬ"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/blue_2" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>