<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.WelcomeActivity">

    <LinearLayout
        android:id="@+id/internetConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_3"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/internet_lost" />

        <TextView
            android:id="@+id/offlineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/you_are_offline"
            android:textColor="@color/black_3"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- REPLACED VIDEO WITH RIVE ANIMATION CONTAINER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/welcome_screen_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="94dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="true"
        android:clipToOutline="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/text_content_wrapper"
        app:layout_constraintDimensionRatio="1:1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internetConnection"
        app:strokeColor="@color/gray_2"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/welcome_rive_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleX="1.25"
                android:scaleY="1.25"
                app:riveAutoPlay="true"
                app:riveResource="@raw/tetragon_intro"
                app:riveStateMachine="State Machine 1" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/correct_mr_square"
        android:layout_width="135dp"
        android:layout_height="95dp"
        app:layout_constraintBottom_toTopOf="@+id/welcome_screen_card"
        app:layout_constraintEnd_toEndOf="@+id/welcome_screen_card"
        app:layout_constraintStart_toStartOf="@+id/welcome_screen_card"
        app:riveAutoPlay="true"
        app:riveResource="@raw/mr_square_correct"
        app:riveStateMachine="State Machine 1" />

    <LinearLayout
        android:id="@+id/text_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/start_btn_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/logo_branding_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tetragon_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_blue"
                android:tint="@color/gray_2"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/tetragon_logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="0.05"
                android:text="@string/tetragon"
                android:textColor="@color/gray_2"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tetragon_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/learn_natural_sciences"
            android:textColor="@color/blue_2"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tetragon_description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/transform_the_learning_process_into_an_interactive_and_fun_experience"
            android:textColor="@color/text_color"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/offlineContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/start_btn_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/internetConnection">

        <app.rive.runtime.kotlin.RiveAnimationView
            android:id="@+id/internet_mr_square"
            android:layout_width="260dp"
            android:layout_height="180dp"
            app:riveAutoPlay="true"
            app:riveResource="@raw/no_internet_mr_square"
            app:riveStateMachine="State Machine 1" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/app_is_currently_unavailable"
            android:textColor="@color/black_3"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/offlineSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/check_your_connection_or_try_again_later"
            android:textAlignment="center"
            android:textColor="@color/gray_1"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/start_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toTopOf="@id/login_btn_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/start_enabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/blue_1"
                android:translationY="5dp" />

            <Button
                android:id="@+id/start_enabled_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/inter_semibold"
                android:stateListAnimator="@drawable/button_animator"
                android:text="@string/start_text"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/blue_2" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/start_disabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/gray_2"
                android:translationY="5dp" />

            <TextView
                android:id="@+id/start_disabled_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/start_text"
                android:textColor="@color/gray_1"
                android:textSize="17sp"
                android:translationY="5dp" />
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/login_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/login_enabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/black_2"
                android:translationY="5dp" />

            <Button
                android:id="@+id/login_enabled_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/inter_semibold"
                android:stateListAnimator="@drawable/button_animator"
                android:text="@string/login_text"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="@color/black_3" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/login_disabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/gray_2"
                android:translationY="5dp" />

            <TextView
                android:id="@+id/login_disabled_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/login_text"
                android:textColor="@color/gray_1"
                android:textSize="17sp"
                android:translationY="5dp" />
        </FrameLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>