<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    tools:context=".reward.MonthlyRewardActivity">

    <!-- Responsive artboard: LAYOUT reflows the artwork to the view's exact size, so it
         fills all four edges without cropping or stretching the graphics. -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/winnerRive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riveAlignment="CENTER"
        app:riveAutoPlay="true"
        app:riveFit="LAYOUT"
        app:riveResource="@raw/winner_of_the_month"
        app:riveStateMachine="State Machine 1" />

    <!-- Declared after the Rive view so it draws on top of it -->
    <FrameLayout
        android:id="@+id/continue_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ONE button for every state. Enabled/disabled is only a tint swap done in code:
             no second container, no visibility change, no alpha, no transition. -->
        <FrameLayout
            android:id="@+id/continue_enabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="false"
            android:visibility="gone">

            <View
                android:id="@+id/continue_enabled_btn_shadow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="#333333"
                android:translationY="5dp" />

            <Button
                android:id="@+id/continue_enabled_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/custom_button"
                android:fontFamily="@font/inter_semibold"
                android:stateListAnimator="@null"
                android:text="@string/claim_reward"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:backgroundTint="#4E4E4E" />
        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>