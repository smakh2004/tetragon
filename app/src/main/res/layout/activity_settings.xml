<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.uiSettings.SettingsActivity">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <!-- TOP BAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/back_btn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:src="@drawable/back_btn"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/settings"
                    android:textColor="@color/text_color"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/topBar">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/account"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="0.1"
                    android:src="@drawable/continue_btn" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/account">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/premium"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="0.1"
                    android:src="@drawable/continue_btn" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/premium">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/notifications"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/switch_notifications_custom"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_bg"
                        android:padding="2dp">

                        <View
                            android:id="@+id/thumb_notificationss"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/toggle_thumb"
                            android:layout_gravity="start"/>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/switch_notifications_on_custom"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_bg_on"
                        android:padding="2dp"
                        android:visibility="invisible">

                        <View
                            android:id="@+id/thumb_on_notifications"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/toggle_thumb"
                            android:layout_gravity="end"/>
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/notifications">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/sounds"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/switch_sounds_custom"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_bg"
                        android:padding="2dp">

                        <View
                            android:id="@+id/thumb_sounds"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/toggle_thumb"
                            android:layout_gravity="start"/>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/switch_sounds_on_custom"
                        android:layout_width="50dp"
                        android:layout_height="28dp"
                        android:background="@drawable/toggle_bg_on"
                        android:padding="2dp"
                        android:visibility="invisible">

                        <View
                            android:id="@+id/thumb_on_sounds"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/toggle_thumb"
                            android:layout_gravity="end"/>
                    </FrameLayout>
                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/sounds">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/language"
                    android:textColor="@color/text_color"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="0.1"
                    android:src="@drawable/continue_btn" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/logOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_background"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:paddingStart="30dp"
                android:paddingTop="14dp"
                android:paddingEnd="15dp"
                android:paddingBottom="14dp"
                app:layout_constraintTop_toBottomOf="@+id/language">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/log_out"
                    android:textColor="@color/blue_1"
                    android:textSize="20sp"
                    app:layout_constraintTop_toBottomOf="@+id/topBar" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_weight="0.1"
                    android:src="@drawable/continue_btn" />
            </LinearLayout>


            <!-- PRIVACY AND POLICY TEXT -->
            <TextView
                android:id="@+id/privacyPolicyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/privacy_policy"
                android:textColor="@color/blue_1"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>