<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="24dp"
    tools:context=".questions.questionMathFourthGrade.secondTopic.UiColumnMultiplicationFragment">

    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="@string/title_multiply_numbers"
        android:textColor="@color/text_color"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/mathContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/row1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction"
        app:layout_constraintVertical_bias="0.15">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNum1Tens"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_color"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvNum1Ones"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_color"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/blue_2"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvNum2Tens"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_color"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvNum2Ones"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_color"
                android:textSize="32sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/blue_2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvP1Static"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="right"
                android:layout_marginEnd="3dp"
                android:text="32"
                android:letterSpacing="0.4"
                android:textColor="@color/text_color"
                android:textSize="32sp" />

            <FrameLayout
                android:id="@+id/frameP1"
                android:layout_width="38dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/ivBoxP1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/answer_default_box" />

                <TextView
                    android:id="@+id/tvInputPartial1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:textColor="@color/text_color"
                    android:textSize="24sp" />

                <View
                    android:id="@+id/cursorP1"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@color/blue_2"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/blue_2"
                android:textSize="26sp" />

            <FrameLayout
                android:id="@+id/frameP2"
                android:layout_width="38dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/ivBoxP2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/answer_default_box" />

                <TextView
                    android:id="@+id/tvInputPartial2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:textColor="@color/text_color"
                    android:textSize="24sp" />

                <View
                    android:id="@+id/cursorP2"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@color/blue_2"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvP2Static"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_color"
                android:textSize="32sp" />

            <View
                android:layout_width="32dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/blue_2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFinalStaticLeft"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_color"
                android:textSize="32sp" />

            <FrameLayout
                android:id="@+id/frameFinal"
                android:layout_width="38dp"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/ivBoxFinal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/answer_default_box" />

                <TextView
                    android:id="@+id/tvInputFinal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:textColor="@color/text_color"
                    android:textSize="24sp" />

                <View
                    android:id="@+id/cursorFinal"
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@color/blue_2"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvFinalStaticRight"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_color"
                android:textSize="32sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@id/row2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingRight="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="1"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="2"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="3"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@id/row3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingRight="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="4"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="5"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="6"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@id/row4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingRight="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="7"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="8"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="9"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/number_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="0"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/number_button"
                android:backgroundTint="#E5E5E5"
                android:translationY="5dp" />

            <Button
                android:id="@+id/btnDel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/delete_button"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@drawable/button_animator"
                android:text="⌫"
                android:textColor="#64748b"
                android:textSize="30sp"
                app:backgroundTint="@null" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>