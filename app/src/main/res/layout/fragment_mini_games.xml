<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/mini_games_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:paddingTop="16dp"
        android:text="@string/math_games"
        android:textColor="@color/text_color"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/statsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mini_games_title">

        <LinearLayout
            android:id="@+id/timerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <app.rive.runtime.kotlin.RiveAnimationView
                android:id="@+id/ivClockIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:visibility="invisible"
                app:riveAutoPlay="true"
                app:riveResource="@raw/timer_math_storm"
                app:riveStateMachine="State Machine 1" />

            <TextView
                android:id="@+id/reset_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/red_1"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attemptsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/attempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="5 "
                android:textColor="@color/text_color"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/_5_attempts_left"
                android:textColor="@color/text_color"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout4"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statsContainer">

        <View
            android:id="@+id/progressBackground"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:background="@drawable/line_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/progressActive"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:background="@drawable/line_active_red"
            app:layout_constraintBottom_toBottomOf="@id/progressBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/progressBackground"
            app:layout_constraintWidth_percent="0" />

        <View
            android:id="@+id/step1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/step2"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/step2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/step3"
            app:layout_constraintStart_toEndOf="@id/step1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/step3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/step4"
            app:layout_constraintStart_toEndOf="@id/step2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/step4"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/step5"
            app:layout_constraintStart_toEndOf="@id/step3"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/step5"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step4"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/miniGamesLineDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@color/gray_2"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout4" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/miniGamesLineDivider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/math_storm_card_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@+id/start_math_storm_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/mathstormicon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/math_storm_score_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/loading"
                            android:textColor="@color/text_color"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/math_storm_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="start"
                            android:text="@string/math_storm"
                            android:textColor="@color/gray_1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/start_math_storm_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <FrameLayout
                        android:id="@+id/start_math_storm_enabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="#e72529"
                            android:translationY="5dp" />

                        <Button
                            android:id="@+id/start_math_storm_enabled_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:fontFamily="@font/inter_semibold"
                            android:stateListAnimator="@drawable/button_animator"
                            android:text="@string/start_10xp"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            app:backgroundTint="#FF4B4D" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/start_math_storm_disabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="@color/gray_2"
                            android:translationY="5dp" />

                        <TextView
                            android:id="@+id/start_math_storm_disabled_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/start_10xp"
                            android:textColor="@color/gray_1"
                            android:textSize="17sp"
                            android:translationY="5dp" />
                    </FrameLayout>
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/storm_divider"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@color/gray_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/math_storm_card_container" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/online_game_card_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/storm_divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@+id/create_online_game_btn_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/battlestormicon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/play_online_score_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/loading"
                            android:textColor="@color/text_color"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/online_math_storm_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="start"
                            android:text="@string/battle_storm"
                            android:textColor="@color/gray_1"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/player_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/profile_online" />

                            <TextView
                                android:id="@+id/online_players"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_tight"
                                android:text="@string/loading"
                                android:textColor="@color/blue_1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/create_online_game_btn_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/private_game_btn_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <FrameLayout
                        android:id="@+id/play_online_bton_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="#e72529"
                            android:translationY="5dp" />

                        <Button
                            android:id="@+id/play_online_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:fontFamily="@font/inter_semibold"
                            android:stateListAnimator="@drawable/button_animator"
                            android:text="@string/play_online_xp"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            app:backgroundTint="#FF4B4D" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/play_online_disabled_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="#E5E5E5"
                            android:translationY="5dp" />

                        <TextView
                            android:id="@+id/play_online_disabled_container_txt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/play_online_xp"
                            android:textColor="#A5A5A5"
                            android:textSize="17sp"
                            android:translationY="5dp" />
                    </FrameLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/private_game_btn_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingBottom="5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <FrameLayout
                        android:id="@+id/private_game_enabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="@color/orange_1"
                            android:translationY="5dp" />

                        <Button
                            android:id="@+id/private_game_enabled_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:fontFamily="@font/inter_semibold"
                            android:stateListAnimator="@drawable/button_animator"
                            android:text="@string/private_game"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            app:backgroundTint="@color/yellow_1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/private_game_disabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="#E5E5E5"
                            android:translationY="5dp" />

                        <TextView
                            android:id="@+id/private_game_disabled_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/private_game"
                            android:textColor="#A5A5A5"
                            android:textSize="17sp"
                            android:translationY="5dp" />
                    </FrameLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/cash_storm_divider"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@color/gray_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/online_game_card_container" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cash_storm_card_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cash_storm_divider">

                <LinearLayout
                    android:id="@+id/cash_storm_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/cash_storm_icon"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/cash_storm" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cash_storm_balance_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/loading"
                            android:textColor="@color/text_color"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/cash_storm_title_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/cash_storm"
                            android:textColor="@color/gray_1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/start_cash_storm_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cash_storm_info_layout">

                    <FrameLayout
                        android:id="@+id/cash_storm_enabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="@color/red_2"
                            android:translationY="5dp" />

                        <Button
                            android:id="@+id/start_cash_storm_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:fontFamily="@font/inter_semibold"
                            android:stateListAnimator="@drawable/button_animator"
                            android:text="@string/start_10xp"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            app:backgroundTint="@color/red_1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cash_storm_disabled_btn_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="invisible">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_button"
                            android:backgroundTint="@color/gray_2"
                            android:translationY="5dp" />

                        <TextView
                            android:id="@+id/start_cash_storm_disabled_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/start_10xp"
                            android:textColor="@color/gray_1"
                            android:textSize="17sp"
                            android:translationY="5dp" />
                    </FrameLayout>
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/blue_2" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/loading"
                android:textColor="@color/text_color" />
        </LinearLayout>
    </FrameLayout>

