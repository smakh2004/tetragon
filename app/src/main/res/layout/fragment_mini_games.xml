<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ================= HEADER (blue) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_2"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/math_storm_title"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/headerSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/math_storm_subtitle"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerTitle" />

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerSubtitle">

            <!-- ===== RECORD ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="4dp"
                android:paddingEnd="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:paddingBottom="4dp"
                    android:text="@string/record_caps"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_body"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_stat_record" />

                    <TextView
                        android:id="@+id/recordValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== WINS ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="4dp"
                android:paddingEnd="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:paddingBottom="4dp"
                    android:text="@string/wins_caps"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_body"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_stat_wins" />

                    <TextView
                        android:id="@+id/winsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== LOSES ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="4dp"
                android:paddingEnd="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:paddingBottom="4dp"
                    android:text="@string/loses_caps"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_body"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_stat_loses" />

                    <TextView
                        android:id="@+id/losesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= ROOM LIST ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomsRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        tools:listitem="@layout/item_online_room" />

    <TextView
        android:id="@+id/emptyRoomsText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/no_open_rooms"
        android:textColor="@color/gray_1"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/roomsRecycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/roomsRecycler" />

    <!-- ================= BOTTOM BAR ================= -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ============ PLAY ONLINE ============ -->
        <FrameLayout
            android:id="@+id/playOnlineBtnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="5dp">

            <!-- ENABLED -->
            <FrameLayout
                android:id="@+id/playOnlineEnabledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="#C3E4F4"
                    android:translationY="5dp" />

                <Button
                    android:id="@+id/playOnlineBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:fontFamily="@font/inter_semibold"
                    android:stateListAnimator="@drawable/button_animator"
                    android:text="@string/play_online_50_xp"
                    android:textColor="@color/blue_2"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white" />
            </FrameLayout>

            <!-- DISABLED (SEARCHING… / LOADING) -->
            <FrameLayout
                android:id="@+id/playOnlineDisabledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible">

                <!-- 3D Shadow Base -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button_no_stroke"
                    android:backgroundTint="#087BAA"
                    android:translationY="5dp" />

                <!-- Pressed Button Surface -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button_no_stroke"
                    android:backgroundTint="#00A6D2"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:translationY="5dp">

                    <app.rive.runtime.kotlin.RiveAnimationView
                        android:id="@+id/searchingIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:riveResource="@raw/search_icon"
                        app:riveAutoPlay="true"
                        app:riveFit="CONTAIN" />

                    <TextView
                        android:id="@+id/playOnlineDisabledTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/searching_dots"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- ============ SOLO GAME ============ -->
        <FrameLayout
            android:id="@+id/soloBtnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="5dp">

            <!-- ENABLED -->
            <FrameLayout
                android:id="@+id/soloEnabledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="#C3E4F4"
                    android:translationY="5dp" />

                <Button
                    android:id="@+id/soloGameBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:fontFamily="@font/inter_semibold"
                    android:stateListAnimator="@drawable/button_animator"
                    android:text="@string/solo_game_30_xp"
                    android:textColor="@color/blue_2"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white" />
            </FrameLayout>

            <!-- DISABLED (LOADING) -->
            <FrameLayout
                android:id="@+id/soloDisabledContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="invisible">

                <!-- 3D Shadow Base -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button_no_stroke"
                    android:backgroundTint="#00A6D2"
                    android:translationY="5dp" />

                <!-- Pressed Button Surface -->
                <TextView
                    android:id="@+id/soloDisabledTxt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button_no_stroke"
                    android:backgroundTint="#00A6D2"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/solo_game_30_xp"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:translationY="5dp" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ================= LOADING ================= -->
    <FrameLayout
        android:id="@+id/loadingOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/blue_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/loading"
                android:textColor="@color/text_color" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>