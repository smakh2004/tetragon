<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".questions.StreakGainedActivity">

    <!-- STREAK ANIMATION — fills the whole screen -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/streak_rive_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riveAlignment="CENTER"
        app:riveAutoPlay="true"
        app:riveFit="COVER"
        app:riveResource="@raw/streak"
        app:riveStateMachine="State Machine 1" />

    <!-- CONTINUE BUTTON — revealed after the animation has played.
         INVISIBLE (not GONE) so the animation keeps its size. -->
    <FrameLayout
        android:id="@+id/continue_btn_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="5dp"
        android:translationZ="10dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/continue_enabled_button_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/custom_button"
            android:backgroundTint="@color/black_2"
            android:translationY="5dp" />

        <Button
            android:id="@+id/continue_enabled_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/custom_button"
            android:fontFamily="@font/inter_semibold"
            android:stateListAnimator="@drawable/button_animator"
            android:text="@string/continue_text"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/black_3" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>