<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".questions.questionMathFirstGrade.firstTopicCountingNumbers.easy.UiAppleCountFragment">

    <!-- Teacher character: reads the question out loud (mouth viseme via ViewModel1) -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/teacherAnimation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintDimensionRatio="H,11:11"
        android:layout_marginStart="-28dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:riveAlignment="BOTTOM_CENTER"
        app:riveFit="CONTAIN"
        app:riveResource="@raw/teacher_animation"
        app:riveStateMachine="State Machine 1" />

    <TextView
        android:id="@+id/questionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-28dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Show 5 apples"
        android:textColor="@color/text_color"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/teacherAnimation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/teacherAnimation"
        app:layout_constraintTop_toTopOf="@id/teacherAnimation" />

    <!-- Whichever of the two is taller pushes the apples down -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="teacherAnimation,questionText" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/gray_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier" />

    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/appleCountAnimation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier"
        app:layout_constraintWidth_max="420dp"
        app:riveAlignment="CENTER"
        app:riveFit="CONTAIN"
        app:riveResource="@raw/apples_count"
        app:riveStateMachine="State Machine 1" />

    <LinearLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/minus_enabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">
                <View
                    android:id="@+id/minus_btn_back"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/black_2"
                    android:translationY="5dp" />
                <LinearLayout
                    android:id="@+id/minus_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/black_3"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@drawable/button_animator">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_minus_icon"/>

                    <TextView
                        android:id="@+id/minus_btn_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apple"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/minus_disabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/gray_2"
                    android:translationY="5dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/gray_2"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:translationY="5dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_disabled_minus_icon"/>
                    <TextView
                        android:id="@+id/minus_btn_disabled_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/gray_1"
                        android:textSize="20sp"
                        android:text="@string/apple"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/add_enabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/add_btn_back"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/black_2"
                    android:translationY="5dp" />
                <LinearLayout
                    android:id="@+id/add_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/black_3"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@drawable/button_animator">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_icon"/>

                    <TextView
                        android:id="@+id/add_btn_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apple"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/add_disabled_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/gray_2"
                    android:translationY="5dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/custom_button"
                    android:backgroundTint="@color/gray_2"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:translationY="5dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_disabled_add_icon"/>
                    <TextView
                        android:id="@+id/add_btn_disabled_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/gray_1"
                        android:textSize="20sp"
                        android:text="@string/apple"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>