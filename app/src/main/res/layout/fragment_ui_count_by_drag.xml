<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".questions.questionMathFirstGrade.firstTopicCountingNumbers.hard.UiCountByDragFragment">

    <!-- Teacher character: reads the instruction out loud (ViewModel1 / mouth) -->
    <app.rive.runtime.kotlin.RiveAnimationView
        android:id="@+id/teacherAnimation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-28dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="H,11:11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.55"
        app:riveAlignment="BOTTOM_CENTER"
        app:riveFit="CONTAIN"
        app:riveResource="@raw/teacher_animation"
        app:riveStateMachine="State Machine 1" />

    <TextView
        android:id="@+id/instructionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-28dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Count by 2:"
        android:textColor="@color/text_color"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/teacherAnimation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/teacherAnimation"
        app:layout_constraintTop_toTopOf="@id/teacherAnimation" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="teacherAnimation,instructionText" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/gray_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBarrier" />

    <!-- Sequence with TWO blank boxes: v1, [ ], v3, [ ], v5 -->
    <LinearLayout
        android:id="@+id/problemRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tileTray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <TextView
            android:id="@+id/tvSeq1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="2, "
            android:textColor="#64748b"
            android:textSize="32sp" />

        <!-- Slot A -->
        <FrameLayout
            android:id="@+id/slotA"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/slotAEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="slot a"
                android:src="@drawable/answer_blue_box" />

            <View
                android:id="@+id/slotAShadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_shadow"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/slotAButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slotAText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@color/text_color"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSeq3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text=", 6, "
            android:textColor="#64748b"
            android:textSize="32sp" />

        <!-- Slot B -->
        <FrameLayout
            android:id="@+id/slotB"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/slotBEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="slot b"
                android:src="@drawable/answer_blue_box" />

            <View
                android:id="@+id/slotBShadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_shadow"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/slotBButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slotBText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/text_color"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSeq5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text=", 10"
            android:textColor="#64748b"
            android:textSize="32sp" />

    </LinearLayout>

    <!-- Draggable buttons: flat white cap with a grey placeholder directly behind.
         While dragging, the cap hides so the grey placeholder marks the origin spot. -->
    <LinearLayout
        android:id="@+id/tileTray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/tile1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/option_btn_shadow">

            <FrameLayout
                android:id="@+id/tile1Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="..."
                    android:textColor="@color/text_color"
                    android:textSize="20sp" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/option_btn_shadow">

            <FrameLayout
                android:id="@+id/tile2Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="..."
                    android:textColor="@color/text_color"
                    android:textSize="20sp" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile3"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/option_btn_shadow">

            <FrameLayout
                android:id="@+id/tile3Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="..."
                    android:textColor="@color/text_color"
                    android:textSize="20sp" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tile4"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/option_btn_shadow">

            <FrameLayout
                android:id="@+id/tile4Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/option_btn_top">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="..."
                    android:textColor="@color/text_color"
                    android:textSize="20sp" />
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>