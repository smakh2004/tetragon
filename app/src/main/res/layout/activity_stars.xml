<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".starsBuy.StarsActivity"
    android:fitsSystemWindows="true">

    <!-- Top Bar Header Layer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/back_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/shop_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/star_up"
            android:textColor="@color/text_color"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlSymmetry">

                <ImageView
                    android:id="@+id/coinIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/coin"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/coinCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:maxLines="1"
                    android:textColor="@color/yellow_1"
                    android:textSize="16sp"
                    tools:text="125" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Solid line divider on bottom of top bar -->
    <View
        android:id="@+id/scrollDivider"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/gray_2"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Persistent Non-Scrollable Bottom Button Container -->
    <FrameLayout
        android:id="@+id/bottom_action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. Active / Enabled Button Frame -->
        <FrameLayout
            android:id="@+id/start_enabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:id="@+id/continue_enabled_btn_back"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/black_2"
                android:translationY="5dp" />

            <LinearLayout
                android:id="@+id/continue_enabled_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/black_3"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@drawable/button_animator">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/buy_for"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/coin"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/confirm_coin_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="15"
                    android:textColor="#F4D03F"
                    android:textSize="17sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Loading / Processing State Frame -->
        <FrameLayout
            android:id="@+id/start_disabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/gray_2"
                android:translationY="5dp" />

            <TextView
                android:id="@+id/start_disabled_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/loading"
                android:textColor="@color/gray_1"
                android:textSize="17sp"
                android:translationY="5dp" />
        </FrameLayout>

        <!-- 3. Inactive State Frame (Default until selection is made) -->
        <FrameLayout
            android:id="@+id/subscribe_disabled_btn_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:visibility="visible"
            tools:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/custom_button"
                android:backgroundTint="@color/gray_2"
                android:translationY="5dp" />

            <TextView
                android:id="@+id/subscribe_disabled_btn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/buy"
                android:textColor="@color/gray_1"
                android:textSize="17sp"
                android:translationY="5dp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Scrollable content region constrained tightly between header and sticky footer button -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/shopScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/scrollDivider"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_container">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/center_star_graphic"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/star_null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/attempts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/text_color"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/center_star_graphic"
                tools:text="Next star in 01m 24s" />

            <!-- Selectable Option: Infinity Stars Layer -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_infinity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/custom_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:paddingStart="30dp"
                app:layout_constraintTop_toBottomOf="@id/attempts_label"
                tools:ignore="RtlSymmetry">

                <ImageView
                    android:id="@+id/icon_infinity"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/star_infinity"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/title_infinity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/infinity"
                    android:textColor="@color/text_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_infinity"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/desc_infinity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/with_full_of_stars_you_can_solve_more_math_problems"
                    android:textColor="@color/gray_1"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_infinity"
                    app:layout_constraintTop_toBottomOf="@id/title_infinity" />

                <LinearLayout
                    android:id="@+id/infinity_price_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_infinity"
                    app:layout_constraintTop_toBottomOf="@id/desc_infinity">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/coin"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/infinity_price_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="1000"
                        android:textColor="#F4D03F"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infinity_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/activated"
                    android:textColor="@color/blue_1"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_infinity"
                    app:layout_constraintTop_toBottomOf="@id/desc_infinity" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Selectable Option: Standard Star Refill Layer -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/item_star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:paddingStart="30dp"
                app:layout_constraintTop_toBottomOf="@id/item_infinity"
                tools:ignore="RtlSymmetry">

                <ImageView
                    android:id="@+id/icon_star"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/star"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/title_star"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/star"
                    android:textColor="@color/text_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icon_star"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/desc_star"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/refill_your_stars_to_continue_your_learning_journey"
                    android:textColor="@color/gray_1"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_star"
                    app:layout_constraintTop_toBottomOf="@id/title_star" />

                <LinearLayout
                    android:id="@+id/star_price_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_star"
                    app:layout_constraintTop_toBottomOf="@id/desc_star">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/coin"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="15"
                        android:textColor="#F4D03F"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/star_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/full_stars"
                    android:textColor="@color/blue_1"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_star"
                    app:layout_constraintTop_toBottomOf="@id/desc_star" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Data Retrieval Interceptor Layer -->
    <FrameLayout
        android:id="@+id/loadingOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/blue_2" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/loading"
                android:textColor="@color/text_color" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>