<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/gradient_border.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Inner gradient background -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f2c728"
                android:centerColor="#bbcae2"
                android:endColor="#9d63e7"
                android:angle="45"/>
            <corners android:radius="96dp"/> <!-- slightly smaller to match border thickness -->
        </shape>
    </item>

</layer-list>